[sub_resource type="GDScript" id="GDScript_mxvw5"]
resource_name = "Day_transition"
script/source = "extends Label3D

func _ready() -> void:
	GlobalValues.connect(\"day_changed\", on_day_changed)
	show_day_info()

func on_day_changed(day : int):
	self.text = \"Day \" + str(day)
	show_day_info()

func show_day_info():
	var tween = create_tween()
	
	self.modulate.a = 0
	tween.tween_property(self, \"modulate:a\", 1, 2)\\
	.set_trans(Tween.TRANS_SINE)\\
	.set_ease(Tween.EASE_IN_OUT)
	#the '\\' allows for newline, so that it's more readable
	
	tween.tween_interval(3) #wait time
	
	tween.tween_property(self, \"modulate:a\", 0, 2)\\
	.set_trans(Tween.TRANS_SINE)\\
	.set_ease(Tween.EASE_IN_OUT)
"

