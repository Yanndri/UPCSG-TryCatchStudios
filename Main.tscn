[sub_resource type="GDScript" id="GDScript_fu7sn"]
resource_name = "MainMenuLamp"
script/source = "extends RigidBody3D

@export var spotlight : SpotLight3D

func _ready():
	swing_loop()
	swing()
	flicker_loop()

func _ready_light():
	var tween = create_tween()
	spotlight.light_energy = 0
	tween.tween_property(spotlight, \"light_energy\", 1, 12)\\
	.set_trans(Tween.TRANS_SINE)\\
	.set_ease(Tween.EASE_IN_OUT)
	#spotlight.light_energy = 1

func _physics_process(_delta: float) -> void:
	apply_impulse(Vector3(randf_range(0, 0.1),0,randf_range(0, 0.05)) * randf_range(0, 0.1))  # push sideway

func swing():
	#apply_impulse(Vector3(1,0,1) * 0.6)  # push sideways
	apply_impulse(Vector3(randf_range(0.5, 1),0,randf_range(0.5, 1)) * randf_range(0.3, 0.8))  # push sideways

func swing_loop():
	while true: #So after finishing the block it returns back
		var random_time = randf_range(10, 69)
		await get_tree().create_timer(random_time).timeout
		swing()

func flicker_loop() -> void:
	while true: #So after finishing the block it returns back
		var random_time = randf_range(5, 15)
		await get_tree().create_timer(random_time).timeout
		flicker()

func flicker():
	for i in range(randf_range(8, 32)):
		# Random delay between flickers
		var delay = randf_range(0.05, 0.3)
		await get_tree().create_timer(delay).timeout

		# Randomize light energy slightly
		spotlight.light_energy = randf_range(0, 1.2)
	spotlight.light_energy = 1 #default value
"

