[node name="Body" type="RichTextLabel" parent="CanvasLayer/Notes/MarginContainer2/VBoxContainer" unique_id=335592899]
layout_mode = 2
bbcode_enabled = true
text = "I don’t know if anyone will ever read this. Maybe I’m writing only to keep my own mind from unraveling. The world outside is already gone.  

It began this morning, when something appeared in the sky. Not a star, not a comet, not a machine. Just… a presence. A shape that wasn’t a shape. Every glance revealed a new form, each more impossible than the last, until the mind itself begged for blindness.  "
fit_content = true
horizontal_alignment = 3

