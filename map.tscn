[sub_resource type="GDScript" id="GDScript_hn12h"]
resource_name = "Lamp"
script/source = "extends RigidBody3D

func _ready():
	random_times()
	swing()

func _physics_process(delta: float) -> void:
	apply_impulse(Vector3(randf_range(0, 0.1),0,randf_range(0, 0.05)) * randf_range(0, 0.1))  # push sideway

func swing():
	#apply_impulse(Vector3(1,0,1) * 0.6)  # push sideways
	apply_impulse(Vector3(randf_range(0.5, 1),0,randf_range(0.5, 1)) * randf_range(0.3, 0.8))  # push sideways

func random_times():
	while true: #So after finishing the block it returns back
		var random_time = randf_range(10, 69)
		await get_tree().create_timer(random_time).timeout
		swing()
"

