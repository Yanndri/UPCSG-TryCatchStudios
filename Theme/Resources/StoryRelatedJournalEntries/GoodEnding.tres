Title = "GoodEnding"
notes = PackedStringArray("Everything goes silent.\n\nNo noises. No movement. No signs of life.\n\nThis feels worse than danger.\n", "I think it\'s time for us to head out.\n\nIt\'s time to be ready and face the outside world")
