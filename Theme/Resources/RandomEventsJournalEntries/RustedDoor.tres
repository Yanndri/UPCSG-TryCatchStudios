[resource]
script = ExtResource("1_rfmt8")
Title = "RustedDoor"
pick_event = true
item_needed = "Toolbox"
sanity_punish = true
notes = PackedStringArray("One of the inner bunker doors is stuck halfway shut.\n\nBehind it, you hear faint breathing.\n\nLeaving it like this feels dangerous.")
good_pick = "Using the Toolbox, you loosen the rusted hinges and seal the door properly.

The breathing stops.
You feel safer.
"
bad_pick = "Using {item_name} wasn't much of a help, but I was able to fix it although it took a lot of time."
