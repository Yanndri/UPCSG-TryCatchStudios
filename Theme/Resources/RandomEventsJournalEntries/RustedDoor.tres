notes = PackedStringArray("Fresh blood trails from the bunker stairs.\n\n It’s not mine.\n\nSomeone or something was here recently.\n\nI noticed a small cut in my shoulder, I just noticed this now")
good_pick = "I carefully clean the blood and treat the small cut.

It's better to be safe than sorry."
bad_pick = "It's probably nothing to fret about, There's other things that I have to focus in."
