Title = "FinalWarning"
sanity_punish = true
notes = PackedStringArray("A symbol is carved into the bunker door overnight.\n\nI don’t recognize it but it feels intentional.\n\nWhoever it is I will stand my ground and wait.\n\nAlthough no one or nothing came.\n\nThis message was a warning.\n")
