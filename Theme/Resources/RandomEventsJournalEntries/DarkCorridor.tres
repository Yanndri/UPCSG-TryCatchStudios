notes = PackedStringArray("The lights flicker.\n\nSomething moves at the edge of your vision inside the bunker.")
good_pick = "I fired into the darkness.

Whatever it was retreats deeper into the tunnels.

It doesn’t return tonight.
"
bad_pick = "I approached it with {item_name}.

Until suddenly something scratched me before disappearing."
